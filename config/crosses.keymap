/*
 * Crosses 36 — port of the Charybdis nano layout (ojfw20/charybdis).
 * Colemak-DH, home-row mods, tri-layer, trackball on the right half.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

// Scroll instead of move while the scroll/game layers are active
// (replaces the old fork's per-layer trackball-bindings). Scaler 1/4
// tames scroll speed; drop the scaler or flip signs if the feel is off.
&trackball_central_listener {
    scroller {
        layers = <5 6 7>;
        input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 4>;
    };
};

/ {
    chosen { zmk,physical-layout = &gggw_crosses_36_layout; };

    combos {
        compatible = "zmk,combos";

        escc {
            bindings = <&kp ESC>;
            key-positions = <4 5>; // B + J
            layers = <0>;
        };
    };

    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
        mo_tog: behavior_mo_tog {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
&kp Q        &kp W       &kp F       &kp P        &kp B            &kp J        &kp L        &kp U       &kp Y       &kp SEMI
&ht LCTRL A  &ht LALT R  &ht LGUI S  &ht LSHFT T  &ht TAB G        &ht TAB M    &ht LSHFT N  &ht LGUI E  &ht LALT I  &ht LCTRL O
&kp Z        &kp X       &kp C       &kp D        &kp V            &kp K        &kp H        &kp COMMA   &kp PERIOD  &kp SLASH
                         &kp LSHFT   &kp SPACE    &mo_tog 4 4      &lt 2 ENTER  &lt 1 BSPC   &kp ESC
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
&kp N1       &kp N2     &kp N3        &kp N4        &kp N5          &kp N6    &kp N7     &kp N8     &kp N9     &kp N0
&kp TAB      &kp GRAVE  &kp C_PREV    &kp C_PP      &kp C_NEXT      &kp SQT   &kp LARW   &kp DARW   &kp UARW   &kp RARW
&caps_word   &kp LALT   &kp C_VOL_DN  &kp C_VOL_UP  &trans          &trans    &kp HOME   &kp PG_DN  &kp PG_UP  &kp END
                        &trans        &trans        &trans          &trans    &trans     &trans
            >;
        };

        Sym {
            display-name = "Sym";
            bindings = <
&kp ESC   &trans    &trans    &trans    &trans           &kp F1    &kp F2   &kp F3   &kp F4   &kp DEL
&kp TAB   &kp LBKT  &kp LBRC  &kp LPAR  &kp EQUAL        &kp F5    &kp F6   &kp F7   &kp F8   &kp SQT
&kp BSLH  &kp RBKT  &kp RBRC  &kp RPAR  &kp MINUS        &kp F9    &kp F10  &kp F11  &kp F12  &trans
                    &trans    &trans    &trans           &trans    &trans   &trans
            >;
        };

        System {
            display-name = "System";
            bindings = <
&trans       &trans  &trans      &trans  &bt BT_SEL 0      &tog 6  &studio_unlock  &trans  &trans  &trans
&bootloader  &trans  &trans      &trans  &bt BT_SEL 1      &trans  &trans          &trans  &trans  &bootloader
&trans       &trans  &bt BT_CLR  &trans  &bt BT_SEL 2      &trans  &trans          &trans  &trans  &trans
                     &trans      &trans  &trans            &trans  &trans          &trans
            >;
        };

        Mouse {
            display-name = "Mouse";
            bindings = <
&kp ESC  &trans  &trans  &trans  &trans        &trans     &trans     &trans     &trans       &to 6
&trans   &trans  &trans  &trans  &trans        &mkp MCLK  &mkp LCLK  &mkp RCLK  &mo_tog 5 5  &trans
&trans   &trans  &trans  &trans  &trans        &trans     &kp PG_DN  &kp PG_UP  &trans       &trans
                 &trans  &trans  &trans        &trans     &trans     &trans
            >;
        };

        Scroll {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans        &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans        &mkp MCLK  &mkp LCLK  &mkp RCLK  &trans  &trans
&trans  &trans  &trans  &trans  &trans        &trans     &trans     &trans     &trans  &trans
                &trans  &trans  &trans        &trans     &trans     &trans
            >;
        };

        Game {
            display-name = "Game";
            bindings = <
&kp T   &kp Q      &kp W      &kp E        &kp R            &trans  &trans  &trans  &trans  &to 0
&kp G   &kp A      &kp S      &kp D        &kp F            &trans  &trans  &trans  &trans  &trans
&kp Z   &kp X      &kp C      &kp V        &kp LCTRL        &trans  &trans  &trans  &trans  &trans
                   &kp LSHFT  &kp SPACE    &mo_tog 7 7      &trans  &trans  &trans
            >;
        };

        Game2 {
            display-name = "Game2";
            bindings = <
&kp ESC   &kp N1  &kp N2  &kp N3  &kp N4        &trans  &trans  &trans  &trans  &to 0
&kp TAB   &kp N5  &kp N6  &kp N7  &kp N8        &trans  &trans  &trans  &trans  &trans
&kp LALT  &kp N9  &kp N0  &trans  &trans        &trans  &trans  &trans  &trans  &trans
                  &trans  &trans  &to 6         &trans  &trans  &trans
            >;
        };
    };
};
